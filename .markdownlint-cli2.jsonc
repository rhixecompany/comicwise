{
  "config": {
    "MD001": false,
    "MD003": false,
    "MD007": { "indent": 2 },
    "MD010": { "code_blocks": false },
    "MD013": false,
    "MD024": false,
    "MD025": false,
    "MD026": false,
    "MD028": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
